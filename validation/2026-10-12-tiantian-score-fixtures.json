  "fields": {
    "compression": "input: raw signed score. expected: QiPuUtil.alc(input), a compressed score preserving sign within its domain.",
    "engineScore": "input.type and input.value form a synthetic UCI info score field. parsedScore comes from PFAIReplyInfo.pT; normalizedScore is AIUtil.oPa(parsedScore). Scores remain in the input perspective; no FEN or side conversion is performed here.",
    "moveQuality": "beforeRedScore and afterRedScore are both red-perspective scores already in the client score scale. moverColor 1=red, 2=black. Expected compression is after the source color sign conversion; loss is compressedBefore minus compressedAfter; moveScore is the exact JY return value.",
    "reviewFlow": "before and after are raw UCI cp or mate scores already expressed from the SAME root mover perspective. pT decodes each score; oPa gives clientBefore/clientAfter; alc gives compressedBefore/compressedAfter; JY(clientBefore, clientAfter, 1) gives score. qualityColor=1 is a synthetic red argument preserving that shared mover perspective, not a claim that the actual mover must be red.",
    "parser": "input is an authored UCI-like info line. expected is the parser value object, or null when rejected. yYe is the optional integer prefix; pv retains tokens from pv to line end."
  },
  "comparison": {
    "numericAbsoluteTolerance": 1e-10,
    "integerOutputsExact": true,
    "preserveOutputBeforeDisplayRounding": true
  },
  "observedQuirks": [
    "JY returns 100 for after=+30000 or -30000 regardless of the prior score or mover color.",
    "alc returns 0 outside absolute score 30000; it does not saturate at 1000.",
    "oPa passes through absolute cp<=15 and absolute cp>29000; exactly 29000 is still multiplied by 2.9 and rounded.",
    "The linear oPa branch uses JavaScript Math.round directly, so signed half-integers are not odd-symmetric: cp 705 and -705 do not normalize to exact negatives.",
    "pT mate 0 maps to -29999; positive and negative mate distances have different one-unit offsets."
  ],
